# Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/bytefood
DB_USERNAME=
DB_PASSWORD=

# Security (generate: openssl rand -base64 32)
JWT_SECRET_KEY=
REDIS_PASSWORD=

# Backend
REGISTRATION_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
TRACING_SAMPLING_PROBABILITY=0.1
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Traefik / TLS
ACME_EMAIL=you@example.com

# Docker registry (watchtower)
GIHUB_USERNAME=
VPS_WatchTower_Read=

# POS desktop client
BYTEFOOD_API_URL=http://localhost:8080

# Frontend
VITE_API_BASE_URL=/api
VITE_MOCK_MODE=false
