{
  "title": "App - Metrics (Prometheus)",
  "description": "Szczegółowe metryki techniczne dla serwisów Spring Boot. Użycie CPU, pamięć JVM, Garbage Collector, ruch HTTP oraz Message Broker i Baza danych.",
  "tags": ["spring-boot", "prometheus", "jvm", "kafka", "postgres"],
  "timezone": "browser",
  "refresh": "10s",
  "schemaVersion": 38,
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "service",
        "options": [],
        "query": { "query": "label_values(up, job)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "type": "query"
      },
      {
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "instance",
        "options": [],
        "query": { "query": "label_values(up{job=~\"$service\"}, instance)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "1. Instance Health (JVM & System)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "CPU Usage",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "system_cpu_usage{job=~\"$service\", instance=~\"$instance\"}",
          "legendFormat": "System CPU - {{instance}}",
          "refId": "A"
        },
        {
          "expr": "process_cpu_usage{job=~\"$service\", instance=~\"$instance\"}",
          "legendFormat": "JVM Process CPU - {{instance}}",
          "refId": "B"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 }
      }
    },
    {
      "type": "timeseries",
      "title": "JVM Memory Allocation",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=~\"$service\", instance=~\"$instance\", area=\"heap\"}) by (instance)",
          "legendFormat": "Used Heap - {{instance}}",
          "refId": "A"
        },
        {
          "expr": "sum(jvm_memory_used_bytes{job=~\"$service\", instance=~\"$instance\", area=\"nonheap\"}) by (instance)",
          "legendFormat": "Used Non-Heap - {{instance}}",
          "refId": "B"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 } }
    },
    {
      "type": "timeseries",
      "title": "JVM Live Threads",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "jvm_threads_live_threads{job=~\"$service\", instance=~\"$instance\"}",
          "legendFormat": "Live - {{instance}}",
          "refId": "A"
        },
        {
          "expr": "jvm_threads_daemon_threads{job=~\"$service\", instance=~\"$instance\"}",
          "legendFormat": "Daemon - {{instance}}",
          "refId": "B"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 } }
    },
    {
      "type": "timeseries",
      "title": "GC Pause Time",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{job=~\"$service\", instance=~\"$instance\"}[2m])",
          "legendFormat": "Avg Pause Rate",
          "refId": "A"
        },
        {
          "expr": "max_over_time(jvm_gc_pause_seconds_max{job=~\"$service\", instance=~\"$instance\"}[2m])",
          "legendFormat": "Max Pause Time",
          "refId": "B"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } }
    },
    {
      "type": "row",
      "title": "2. Service SLO & Traffic",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },
    {
      "type": "timeseries",
      "title": "Request Rate by URI (req/sec)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"$service\", instance=~\"$instance\"}[1m])) by (uri)",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }
      },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 } }
    },
    {
      "type": "timeseries",
      "title": "Error Rate by URI (5xx req/sec)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"$service\", instance=~\"$instance\", status=~\"5..\"}[1m])) by (uri)",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 30 }
        }
      }
    },
    {
      "type": "row",
      "title": "3. Database & Message Broker",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }
    },
    {
      "type": "timeseries",
      "title": "HikariCP Connection Pool (Postgres)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "targets": [
        {
          "expr": "hikaricp_connections_active{job=~\"$service\", instance=~\"$instance\"}",
          "legendFormat": "Active - {{instance}}",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle{job=~\"$service\", instance=~\"$instance\"}",
          "legendFormat": "Idle - {{instance}}",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_max{job=~\"$service\", instance=~\"$instance\"}",
          "legendFormat": "Max - {{instance}}",
          "refId": "C"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] }
      },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "decimals": 0 } }
    },
    {
      "type": "timeseries",
      "title": "Kafka Traffic (Messages/sec)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "targets": [
        {
          "expr": "sum(rate(kafka_producer_record_send_total{job=~\"$service\", instance=~\"$instance\"}[2m])) by (topic)",
          "legendFormat": "Produced - {{topic}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(kafka_consumer_records_consumed_total{job=~\"$service\", instance=~\"$instance\"}[2m])) by (topic)",
          "legendFormat": "Consumed - {{topic}}",
          "refId": "B"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 } }
    }
  ]
}