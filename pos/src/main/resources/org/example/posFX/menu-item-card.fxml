<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<!--
  Szablon dla pojedynczej karty produktu w menu.
  Każdy kafelek zawiera: zdjęcie (50%), nazwę, cenę i przycisk.
  Kontrolerem dla tej karty jest MenuItemCardController.
-->
<VBox fx:id="card" styleClass="menu-card"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.posFX.MenuItemCardController">

    <children>
        <!-- Zdjęcie produktu - górna połowa kafelka -->
        <ImageView fx:id="productImage" styleClass="menu-image"
                   fitHeight="150" fitWidth="250"
                   preserveRatio="false" pickOnBounds="true" />

        <!-- Dolna sekcja z informacjami -->
        <VBox styleClass="menu-info-section">
            <children>
                <Label fx:id="nameLabel" styleClass="menu-name" text="[Nazwa Produktu]" />
                <Label fx:id="priceLabel" styleClass="menu-price" text="0.00 zł" />
                <Button fx:id="addButton" styleClass="menu-add-btn"
                        onAction="#onAddButtonClicked" text="Dodaj do zamówienia" />
            </children>
        </VBox>
    </children>
</VBox>
